name: backend

on:
  push:
    paths:
      - "backend/**"
      - ".github/workflows/backend.yml"
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: backend
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version: "1.22"
      - run: go mod tidy
      - run: go vet ./...
      - name: Build arm64
        run: GOOS=linux GOARCH=arm64 go build -o samuserve-arm64 .
      - name: Build amd64
        run: GOOS=linux GOARCH=amd64 go build -o samuserve-amd64 .
      - uses: actions/upload-artifact@v4
        with:
          name: samuserve-binaries
          path: |
            backend/samuserve-arm64
            backend/samuserve-amd64
